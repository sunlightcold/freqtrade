# Copy this file to .env before running docker compose.
#
# Image built from your fork. Use the GHCR image produced by your Actions
# workflow on the server, for example:
# FREQTRADE_IMAGE=ghcr.io/<your-github-user>/freqtrade:develop
FREQTRADE_IMAGE=your-registry/your-freqtrade:latest

# Nginx image used to serve the installed FreqUI static files.
FREQUI_IMAGE=nginx:1.27-alpine

# 200U dry-run profile by default. Override this if you want to run the 10,000U
# research profile or another config.
FREQTRADE_CONFIG=config_binance_stage13_validated_20pair_200u_dryrun.json

# Strategy class name passed to `freqtrade trade --strategy`.
FREQTRADE_STRATEGY=Intp20Stage13Validated20Strategy

# Optional extra Freqtrade CLI arguments appended after the primary config.
# The most common use is adding another --config file for server-only overrides:
# FREQTRADE_EXTRA_CONFIG_ARGS=--config /freqtrade/user_data/config_server_api_override.json
# Leave empty when the primary config already contains everything you need.
FREQTRADE_EXTRA_CONFIG_ARGS=

# Container names used by docker compose.
FREQTRADE_CONTAINER_NAME=freqtrade
FREQUI_INIT_CONTAINER_NAME=frequi-init
FREQUI_CONTAINER_NAME=frequi

# Freqtrade API / FreqUI login credentials. Replace all secrets before deploy.
FREQTRADE_API_USERNAME=freqtrader
FREQTRADE_API_PASSWORD=change-this-strong-password
FREQTRADE_API_JWT_SECRET_KEY=change-this-long-random-jwt-secret
FREQTRADE_API_WS_TOKEN=change-this-long-random-websocket-token

# Exchange API credentials. Leave empty for public-data-only dry-run.
# For live trading, use IP allowlisting and never enable withdrawal permission.
FREQTRADE_EXCHANGE_KEY=
FREQTRADE_EXCHANGE_SECRET=

# Port bindings. 127.0.0.1 keeps UI/API private and expects SSH tunneling.
# Use 0.0.0.0 only when protected by a firewall or reverse proxy.
FREQTRADE_API_BIND=127.0.0.1
FREQTRADE_API_PORT=8080
FREQUI_BIND=127.0.0.1
FREQUI_PORT=8081
