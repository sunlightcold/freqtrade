# Copy this file to .env and set the image you publish from your fork.
FREQTRADE_IMAGE=your-registry/your-freqtrade:latest
FREQUI_IMAGE=nginx:1.27-alpine

# 200U dry-run profile by default. Override this if you want to run the 10,000U
# research profile or another config.
FREQTRADE_CONFIG=config_binance_stage13_validated_20pair_200u_dryrun.json
FREQTRADE_STRATEGY=Intp20Stage13Validated20Strategy
FREQTRADE_EXTRA_CONFIG_ARGS=

FREQTRADE_CONTAINER_NAME=freqtrade
FREQUI_INIT_CONTAINER_NAME=frequi-init
FREQUI_CONTAINER_NAME=frequi

FREQTRADE_API_USERNAME=freqtrader
FREQTRADE_API_PASSWORD=change-this-strong-password
FREQTRADE_API_JWT_SECRET_KEY=change-this-long-random-jwt-secret
FREQTRADE_API_WS_TOKEN=change-this-long-random-websocket-token
FREQTRADE_EXCHANGE_KEY=
FREQTRADE_EXCHANGE_SECRET=

FREQTRADE_API_BIND=127.0.0.1
FREQTRADE_API_PORT=8080
FREQUI_BIND=127.0.0.1
FREQUI_PORT=8081
