# 服务器部署模板。
# 在服务器上复制为 .env，并在启动前替换所有占位值。

# 由当前 fork 的 .github/workflows/fork-ghcr-image.yml 构建发布。
FREQTRADE_IMAGE=ghcr.io/sunlightcold/freqtrade:develop
FREQUI_IMAGE=nginx:1.27-alpine

# 默认使用 200U 模拟盘配置。10000U 配置只建议用于研究和回放。
FREQTRADE_CONFIG=config_binance_stage13_validated_20pair_200u_dryrun.json

# 追加到主配置文件后面的 Freqtrade 命令行参数。
# 当前默认值会额外加载 user_data 里的服务器 API/UI 覆盖配置。
# 如果主配置已经包含全部设置，可以留空。
FREQTRADE_EXTRA_CONFIG_ARGS=--config /freqtrade/user_data/config_server_api_override.json
FREQTRADE_STRATEGY=Intp20Stage13Validated20Strategy

PERMISSIONS_INIT_CONTAINER_NAME=freqtrade-permissions-init-stage13
FREQTRADE_CONTAINER_NAME=freqtrade-stage13
FREQUI_INIT_CONTAINER_NAME=frequi-init-stage13
FREQUI_CONTAINER_NAME=frequi-stage13

# 容器内 Freqtrade 用户的 UID/GID。官方镜像默认是 1000:1000。
# 权限初始化容器会用这个值修正 user_data 目录权限。
FREQTRADE_UID=1000
FREQTRADE_GID=1000

# 服务监听地址和端口。
# Freqtrade API 默认只绑定服务器本机；外网通过 FreqUI 的 nginx 反向代理访问 API。
FREQTRADE_API_BIND=127.0.0.1
FREQTRADE_API_PORT=8080
# FreqUI 可以公网访问。公网暴露前，建议用防火墙只允许你自己的 IP 访问。
FREQUI_BIND=0.0.0.0
FREQUI_PORT=8081

# 部署前必须替换为强密码和随机密钥。不要把真实 .env 提交到 GitHub。
FREQTRADE_API_USERNAME=freqtrader
FREQTRADE_API_PASSWORD=replace-with-a-strong-password
FREQTRADE_API_JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
FREQTRADE_API_WS_TOKEN=replace-with-a-long-random-websocket-token

# 交易所 API 凭证。只跑纯模拟盘时可以留空；需要连接交易所账户时再填写。
FREQTRADE_EXCHANGE_KEY=
FREQTRADE_EXCHANGE_SECRET=
