# 服务器部署模板。首次部署时复制为 .env，并替换密码和密钥。
#
# 当前项目的规范部署入口是 server-deploy 目录：
#   cd server-deploy
#   cp .env.example .env
#   docker compose pull
#   docker compose up -d

# Freqtrade 后端镜像，由本 fork 的 Actions 构建发布。
FREQTRADE_IMAGE=ghcr.io/sunlightcold/freqtrade:develop

# 简体中文 FreqUI 镜像，由本 fork 的 Actions 构建发布。
FREQUI_IMAGE=ghcr.io/sunlightcold/freqtrade-frequi-zh:develop

# 默认使用 200U 模拟盘配置。
FREQTRADE_CONFIG=config_binance_stage13_validated_20pair_200u_dryrun.json

# 默认留空。需要叠加私有配置时再改成：
# --config /freqtrade/user_data/config_server_api_override.json
FREQTRADE_EXTRA_CONFIG_ARGS=
FREQTRADE_STRATEGY=Intp20Stage13Validated20Strategy

PERMISSIONS_INIT_CONTAINER_NAME=freqtrade-permissions-init-stage13
FREQTRADE_CONTAINER_NAME=freqtrade-stage13
FREQUI_CONTAINER_NAME=frequi-stage13

# 容器内 Freqtrade 用户的 UID/GID，官方镜像默认是 1000:1000。
FREQTRADE_UID=1000
FREQTRADE_GID=1000

# API 默认只绑定服务器本机；外网访问统一走 FreqUI 的 8081 反向代理。
FREQTRADE_API_BIND=127.0.0.1
FREQTRADE_API_PORT=8080
FREQUI_BIND=0.0.0.0
FREQUI_PORT=8081

# 部署前必须替换为强密码和随机密钥。
FREQTRADE_API_USERNAME=freqtrader
FREQTRADE_API_PASSWORD=replace-with-a-strong-password
FREQTRADE_API_JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
FREQTRADE_API_WS_TOKEN=replace-with-a-long-random-websocket-token

# 交易所 API 凭证。只跑纯模拟盘时可以留空。
FREQTRADE_EXCHANGE_KEY=
FREQTRADE_EXCHANGE_SECRET=

# Freqtrade 原生环境变量格式是 FREQTRADE__配置段__配置项。
# server-deploy/docker-compose.yml 会把 .env 传进 freqtrade 容器，
# 所以下面这些 FREQTRADE__ 开头的变量会被 Freqtrade 读取。
# 官方格式说明：https://www.freqtrade.io/en/stable/configuration/#environment-variables

# Telegram 交易通知。启用后必须填写 token 和 chat_id。
FREQTRADE__TELEGRAM__ENABLED=false
# FREQTRADE__TELEGRAM__TOKEN=replace-with-your-telegram-bot-token
# FREQTRADE__TELEGRAM__CHAT_ID=replace-with-your-telegram-chat-id
FREQTRADE__TELEGRAM__ALLOW_CUSTOM_MESSAGES=true
