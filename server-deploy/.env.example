# 服务器部署模板。首次部署时复制为 .env，并替换密码和密钥。
#
# 当前项目的规范部署入口是 server-deploy 目录：
#   cd server-deploy
#   cp .env.example .env
#   docker compose pull
#   docker compose up -d

# Freqtrade 后端镜像，由本 fork 的 Actions 构建发布。
FREQTRADE_IMAGE=ghcr.io/sunlightcold/freqtrade:develop

# 简体中文 FreqUI 镜像，由本 fork 的 Actions 构建发布。
FREQUI_IMAGE=ghcr.io/sunlightcold/freqtrade-frequi-zh:develop

# 默认使用 Stage25 1000U 模拟盘配置。
FREQTRADE_CONFIG=config_binance_stage25_composite_scalp_20pair_1000u_dryrun.json

# 默认留空。需要叠加私有配置时再改成：
# --config /freqtrade/user_data/config_server_api_override.json
FREQTRADE_EXTRA_CONFIG_ARGS=
FREQTRADE_STRATEGY=Intp20Stage25CompositeScalpStrategy

# 不固定 container_name。多实例部署时用 docker compose -p 项目名 隔离容器。

# Stage18 热点缓存采集器默认不启动。切换 Stage18 时用：
#   docker compose --profile stage18 up -d
STAGE18_HOTSPOT_INTERVAL_SECONDS=300
STAGE18_HOTSPOT_TIMEOUT_SECONDS=8

# Stage19 激进新币策略默认不启动。切换 Stage19 时用：
#   docker compose --profile stage19 up -d
STAGE19_HOTSPOT_INTERVAL_SECONDS=240
STAGE19_HOTSPOT_TIMEOUT_SECONDS=8

# Stage20 自适应 regime/new-coin 策略默认不启动。切换 Stage20 时用：
#   docker compose --profile stage20 up -d
STAGE20_HOTSPOT_INTERVAL_SECONDS=240
STAGE20_HOTSPOT_TIMEOUT_SECONDS=8

# 容器内 Freqtrade 用户的 UID/GID，官方镜像默认是 1000:1000。
FREQTRADE_UID=1000
FREQTRADE_GID=1000

# API 和 FreqUI 都只绑定服务器本机；外网访问统一走宿主机 Nginx 反向代理。
FREQTRADE_API_BIND=127.0.0.1
FREQTRADE_API_PORT=8080
FREQUI_BIND=127.0.0.1
FREQUI_PORT=8081

# 部署前必须替换为强密码和随机密钥。
FREQTRADE_API_USERNAME=freqtrader
FREQTRADE_API_PASSWORD=replace-with-a-strong-password
FREQTRADE_API_JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
FREQTRADE_API_WS_TOKEN=replace-with-a-long-random-websocket-token

# 交易所 API 凭证。只跑纯模拟盘时可以留空。
FREQTRADE_EXCHANGE_KEY=
FREQTRADE_EXCHANGE_SECRET=
